# MongoDB connection string.
MONGO_URI=
# HTTP port the backend listens on (default 5000).
PORT=
# Secret used to sign staff and app-user JWTs. Use a long random value.
JWT_SECRET=
# Comma-separated list of browser origins allowed by CORS.
ALLOWED_ORIGINS=
# Afri Com gRPC host (default wss.durihub.co.zw).
AFRICOM_GRPC_HOST=
# Afri Com gRPC port (default 50000).
AFRICOM_GRPC_PORT=
# Set to true to use TLS for Afri Com gRPC (default false).
AFRICOM_GRPC_SECURE=
# Afri Com package id sent when verifying credentials (default org.duri.maswerasei).
AFRICOM_PACKAGE_ID=
# Afri Com SIP domain (default localvoip.ai.co.zw).
AFRICOM_DOMAIN=
# Optional. Number of reverse-proxy hops to trust when reading the client IP (integer). Defaults to 1 on Render (detected via RENDER), otherwise off.
TRUST_PROXY=
# Set to exactly true to let user-scoped routes accept a client-supplied user id when no app token is sent. Transition release only.
LEGACY_USERID_ROUTES=
# Username for the first super_admin, read by scripts/create-super-admin.js.
ADMIN_USERNAME=
# Password for the first super_admin, read by scripts/create-super-admin.js.
ADMIN_PASSWORD=
# Base64 of exactly 32 random bytes; encrypts KYC documents and ID numbers. Without it KYC routes return 503 and the reminder job does not start. Losing it makes stored documents unrecoverable.
KYC_ENCRYPTION_KEY=
# Directory for encrypted KYC files (default kyc_storage next to the backend). Must be on persistent storage and never served.
KYC_STORAGE_DIR=
# Maximum size of one KYC upload in megabytes (default 8).
KYC_MAX_UPLOAD_MB=
# Set to true to require a proof of residence document on submission (default not required).
KYC_REQUIRE_PROOF_OF_RESIDENCE=
# Set to false to stop this instance from running the KYC reminder job (default enabled).
KYC_JOB_ENABLED=
# Milliseconds between KYC reminder job runs (default 900000, 15 minutes).
KYC_JOB_INTERVAL_MS=
