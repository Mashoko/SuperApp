# MongoDB connection string.
MONGO_URI=
# HTTP port the backend listens on (default 5000).
PORT=
# Secret used to sign staff and app-user JWTs. Use a long random value.
JWT_SECRET=
# Comma-separated list of browser origins allowed by CORS.
ALLOWED_ORIGINS=
# Afri Com gRPC host (default wss.durihub.co.zw).
AFRICOM_GRPC_HOST=
# Afri Com gRPC port (default 50000).
AFRICOM_GRPC_PORT=
# Set to true to use TLS for Afri Com gRPC (default false).
AFRICOM_GRPC_SECURE=
# Afri Com package id sent when verifying credentials (default org.duri.maswerasei).
AFRICOM_PACKAGE_ID=
# Afri Com SIP domain (default localvoip.ai.co.zw).
AFRICOM_DOMAIN=
# Set to exactly true to let user-scoped routes accept a client-supplied user id when no app token is sent. Transition release only.
LEGACY_USERID_ROUTES=
# Username for the first super_admin, read by scripts/create-super-admin.js.
ADMIN_USERNAME=
# Password for the first super_admin, read by scripts/create-super-admin.js.
ADMIN_PASSWORD=
